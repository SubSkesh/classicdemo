---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import ListDialog from '../components/ListDialog.astro';

interface Props {
  page: 'home' | 'serate' | 'evento';
  title?: string;
  description?: string;
}
const { page, title, description = 'Classic Club, club e after hours a Rimini dal 1987. Circolo privato ARCI.' } = Astro.props;
const fullTitle = title ? `${title} | Classic Club Rimini` : 'Classic Club Rimini';

// transizione di pagina: la nuova pagina si apre dalla fessura centrale, come la hero
const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
const slit = {
  old: { name: 'vt-recede', duration: '0.7s', easing: ease, fillMode: 'both' },
  new: { name: 'vt-slit', duration: '0.9s', easing: ease, fillMode: 'both', delay: '0.05s' },
};
const pageTransition = { forwards: slit, backwards: slit };
---
<!doctype html>
<html lang="it" transition:animate={pageTransition}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <script is:inline>
      // prima del primo paint: decide se mostrare l'intro e se nascondere gli elementi che GSAP rivelerà
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) { d.classList.add('reduced'); return; }
        d.classList.add('js-motion');
        var seen = false;
        try { seen = sessionStorage.getItem('cc-intro-seen') === '1'; } catch (e) {}
        if (!seen && location.pathname === '/') d.classList.add('intro');
      })();
    </script>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <div class="grain" aria-hidden="true"></div>
    <Header />
    <main id="main" data-page={page}>
      <slot />
    </main>
    <Footer />
    <ListDialog />
    <Cursor />
    <script>
      import '../scripts/app';
      import '../scripts/ui';
    </script>
  </body>
</html>
