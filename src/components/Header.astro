---
import Monogram from './Monogram.astro';
const path = Astro.url.pathname;
const isSerate = path.startsWith('/serate');
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Classic Club, torna alla home">
    <Monogram class="brand-mark" />
  </a>
  <nav aria-label="Principale">
    <ul role="list">
      <li><a href="/serate/" aria-current={isSerate ? 'page' : undefined}>Serate</a></li>
      <li class="hide-sm"><a href="/#tesseramento">Tesseramento</a></li>
      <li><a class="pill" href="/serate/" data-dialog-open="dlg-lista" aria-haspopup="dialog">Lista online</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 40;
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px var(--gutter);
    mix-blend-mode: difference;
  }
  .brand { display: block; padding: 6px; margin: -6px; }
  .brand :global(.brand-mark) { width: 46px; color: var(--bone); }
  ul { display: flex; align-items: center; gap: clamp(18px, 3vw, 40px); }
  a { text-decoration: none; font-size: 15px; }
  nav a:not(.pill) { position: relative; padding-block: 8px; }
  nav a:not(.pill)::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: right; transition: transform 0.4s var(--ease-out);
  }
  nav a:not(.pill):hover::after, nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .pill { display: inline-block; border: 1px solid currentColor; border-radius: var(--radius-pill); padding: 9px 18px; }
  @media (max-width: 640px) { .hide-sm { display: none; } }
</style>
