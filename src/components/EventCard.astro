---
import Picture from './Picture.astro';
import { dateParts, eventUrl, allNames, type ClassicEvent } from '../lib/events';

interface Props { event: ClassicEvent; eager?: boolean }
const { event, eager = false } = Astro.props;
const e = event.data;
const d = dateParts(e.date);
const names = allNames(event);
---
<article class="card" data-card>
  <a class="hit" href={eventUrl(event)} data-cursor="Apri" aria-label={`${e.title}, ${d.long}: dettagli e lista`}></a>
  <div class="poster" data-tilt>
    <Picture name={e.poster} alt={`Locandina ${e.title}`} sizes="(min-width: 1024px) 30vw, 80vw" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="info">
    <p class="date display"><span>{d.day}</span>.{d.month}</p>
    <p class="label muted">{d.weekday}, {e.start}–{e.end} <span aria-hidden="true">/</span> {e.label}</p>
    <h3 class="display">{e.title}</h3>
    <p class="who">{names.length ? names.join(', ') : 'Line-up in arrivo'}</p>
  </div>
</article>

<style>
  .card { position: relative; display: grid; gap: 22px; align-content: start; }
  .hit { position: absolute; inset: 0; z-index: 2; border-radius: 4px; }
  .hit:focus-visible { outline-offset: 8px; }
  .poster { position: relative; border-radius: 3px; overflow: hidden; transform-style: preserve-3d; will-change: transform; background: var(--night-2); }
  .poster::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgb(242 240 235 / 0.12); pointer-events: none; }
  .poster :global(img) { width: 100%; transition: transform 1.2s var(--ease-out); }
  .card:hover .poster :global(img) { transform: scale(1.04); }
  .date { font-size: clamp(72px, 8vw, 128px); line-height: 0.78; color: var(--bone); }
  .date span { color: var(--accent); }
  .label { font-size: var(--fs-small); margin-top: 10px; }
  h3 { font-size: clamp(34px, 3.6vw, 56px); font-stretch: 75%; margin-block: 8px 10px; }
  .who { max-width: 36ch; }
</style>
