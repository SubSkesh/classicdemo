---
const text =
  'Dal 1987 il Classic è una casa per chi ama la notte. Un circolo dove si entra per come si è, liberi e rispettati. Si balla fino a quando esce il sole, e la domenica mattina si ricomincia.';
const facts = ['Due piste', 'Piscina e giardino', 'Fino a 600 persone', 'Circolo ARCI dal 1987'];
---
<section class="manifesto wrap" aria-labelledby="manifesto-title">
  <h2 id="manifesto-title" class="sr-only">Chi siamo</h2>
  <p class="sr-only">{text}</p>
  <p class="text" aria-hidden="true" data-manifesto>{text}</p>
  <ul class="facts" role="list">
    {facts.map((f) => <li>{f}</li>)}
  </ul>
</section>

<style>
  .manifesto { padding-block: var(--section); }
  .text {
    font-size: clamp(30px, 4.6vw, 76px); line-height: 1.06; letter-spacing: -0.02em; font-weight: 500;
    max-width: 22ch;
  }
  .text :global(.word) { will-change: color; }
  .facts { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(40px, 6vw, 80px); }
  .facts li { border: 1px solid var(--line); border-radius: var(--radius-pill); padding: 10px 18px; color: var(--ash); }
</style>
