---
import { dateParts, eventUrl, type ClassicEvent } from '../../lib/events';

interface Props { next?: ClassicEvent }
const { next } = Astro.props;
const np = next ? dateParts(next.data.date) : null;

// geometria del monogramma (stessa del logo originale, ricostruita in vettoriale).
// Il marchio resta bianco pieno come l'originale: la luce e il colore stanno nell'ambiente, non sul logo.
const L = 'M90 10H0v119h90v-27H27V37h63z';
const R = 'M135 10h90v119h-90v-27h63V37h-63z';
const walls = [
  { side: 'l', d: L },
  { side: 'r', d: R },
];
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <!-- atmosfera: foschia CSS (sempre), fumo WebGL (solo desktop), fascio di luce -->
  <div class="atmo" aria-hidden="true" data-hero-hide>
    <div class="haze haze-a" data-haze></div>
    <div class="haze haze-b" data-haze></div>
    <canvas class="smoke" data-smoke></canvas>
    <div class="beam" data-beam><span class="beam-core"></span></div>
    <div class="vignette"></div>
  </div>

  <!-- l'insegna: il monogramma originale, bianco pieno, retroilluminato -->
  <div class="sign" aria-hidden="true" data-sign data-hero-hide>
    <div class="bloom" data-bloom></div>
    <svg class="mono" viewBox="-14 -14 253 167">
      {walls.map((w) => (
        <g class="wall" data-wall={w.side}>
          <path class="fill" d={w.d} />
          <path class="rim" d={w.d} data-rim />
        </g>
      ))}
      <rect class="bar" x="99" y="0" width="27" height="139" data-bar />
    </svg>
  </div>

  <h1 id="hero-title" class="title display" aria-label="Classic Club" data-hero-hide data-hero-title>
    <span class="w w-l" aria-hidden="true"><span class="w-in" data-word="l">Classic</span></span>
    <span class="w w-r" aria-hidden="true"><span class="w-in" data-word="r">Club</span></span>
  </h1>

  <div class="copy" data-hero-copy data-hero-hide>
    <div class="about" data-hero-fade>
      <p class="sub">Club e after hours a Rimini, dal 1987. Due piste, una piscina, la domenica mattina.</p>
      <p class="entry">
        Circolo privato, ingresso riservato ai soci. 18+, documento obbligatorio.<br />
        <span lang="en">Members only. 18+ only. ID is required.</span>
      </p>
    </div>
    {next && np && (
      <a class="next" href={eventUrl(next)} data-hero-fade data-cursor="Apri">
        <span class="muted">Prossima serata</span>
        <b>{next.data.title}</b>
        <span class="muted">{np.long}, {next.data.start}–{next.data.end}</span>
      </a>
    )}
  </div>
  <span class="scroll" aria-hidden="true" data-hero-fade data-hero-hide><i></i>Scorri</span>
</section>

<style>
  .hero {
    position: relative; height: 100svh; min-height: 600px; overflow: clip; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: 1fr auto auto 1.1fr auto; justify-items: center;
    padding: calc(84px + env(safe-area-inset-top)) var(--gutter) calc(clamp(20px, 4vh, 44px) + env(safe-area-inset-bottom));
    --beam-w: clamp(22px, 2.6vw, 44px);
  }

  /* ---------- atmosfera ---------- */
  .atmo { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .haze { position: absolute; left: 50%; top: 38%; translate: -50% -50%; border-radius: 50%; will-change: transform; }
  .haze-a {
    width: 130vmax; height: 110vmax;
    background: radial-gradient(closest-side, rgb(242 240 235 / 0.10), rgb(255 45 111 / 0.16) 22%, rgb(180 76 255 / 0.09) 42%, transparent 68%);
  }
  .haze-b {
    top: 80%; width: 90vmax; height: 50vmax;
    background: radial-gradient(closest-side, rgb(92 225 230 / 0.10), transparent 70%);
  }
  .smoke { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: screen; opacity: 0; }
  /* fascio: nucleo bianco come il logo, frange iridescenti appena accennate */
  .beam {
    position: absolute; left: 50%; top: 0; bottom: 0; width: calc(var(--beam-w) * 2.6); translate: -50% 0;
    background: linear-gradient(180deg, transparent, rgb(255 45 111 / 0.22) 22%, rgb(180 76 255 / 0.2) 50%, rgb(92 225 230 / 0.16) 80%, transparent);
    mask: linear-gradient(90deg, transparent, #000 40%, #000 60%, transparent);
    mix-blend-mode: screen; transform-origin: 50% 38%; will-change: transform, opacity;
  }
  .beam-core {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 38%; translate: -50% 0;
    background: linear-gradient(180deg, transparent, rgb(242 240 235 / 0.5) 20%, rgb(242 240 235 / 0.75) 40%, rgb(242 240 235 / 0.5) 64%, transparent 96%);
    mask: linear-gradient(90deg, transparent, #000 45%, #000 55%, transparent);
  }
  .vignette { position: absolute; inset: 0; background: radial-gradient(110% 85% at 50% 40%, transparent 45%, rgb(0 0 0 / 0.88) 100%); }

  /* ---------- insegna ---------- */
  .sign { grid-row: 2; position: relative; width: min(42vw, 62svh); }
  .mono { width: 100%; overflow: visible; }
  .mono :global(.wall) { will-change: transform; }
  .mono :global(.fill), .mono :global(.bar) { fill: var(--bone); }
  .mono :global(.rim) { fill: none; stroke: var(--bone); stroke-width: 1.2; stroke-linejoin: miter; }
  :global(html.reduced) .mono :global(.rim) { display: none; }
  /* retroilluminazione bianca: il logo resta pieno, la luce gli sta dietro */
  .bloom {
    position: absolute; left: 50%; top: 50%; width: 150%; height: 190%; translate: -50% -50%;
    background:
      radial-gradient(closest-side, rgb(242 240 235 / 0.28), rgb(242 240 235 / 0.08) 45%, transparent 70%),
      radial-gradient(closest-side, rgb(255 45 111 / 0.12), transparent 80%);
    mix-blend-mode: screen; pointer-events: none; will-change: transform, opacity;
  }

  /* ---------- titolo: CLASSIC | CLUB separati dalla luce ---------- */
  .title {
    grid-row: 3; width: 100%; margin-top: clamp(16px, 3.6vh, 44px); min-width: 0;
    display: grid; grid-template-columns: minmax(0, 1fr) var(--beam-w) minmax(0, 1fr); align-items: end;
    font-size: min(12.6vw, 21svh); line-height: 0.82;
  }
  .w { display: block; overflow-x: clip; overflow-y: visible; max-width: 100%; }
  .w-l { grid-column: 1; justify-self: end; }
  .w-r { grid-column: 3; justify-self: start; }
  .w-in { display: block; padding-inline: 0.02em; }
  .w-in :global(.ch) { will-change: transform, opacity; }

  /* ---------- testo in basso ---------- */
  .copy { grid-row: 5; width: 100%; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 24px; }
  .sub { max-width: 36ch; font-size: clamp(16px, 1.3vw, 19px); }
  .entry { margin-top: 8px; color: var(--ash); font-size: var(--fs-small); max-width: 48ch; }
  .next { display: grid; gap: 4px; border-left: 2px solid var(--accent); padding-left: 16px; max-width: 290px; text-decoration: none; }
  .next span { font-size: var(--fs-small); }
  .next b { font-family: var(--display); font-stretch: 75%; font-weight: 800; font-size: 26px; text-transform: uppercase; line-height: 1; margin-block: 4px; transition: color 0.3s; }
  .next:hover b { color: var(--accent); }
  .scroll {
    position: absolute; right: var(--gutter); top: 50%; writing-mode: vertical-rl;
    font-size: 12px; letter-spacing: 0.06em; color: var(--ash); display: flex; align-items: center; gap: 12px;
  }
  .scroll i { width: 1px; height: 48px; background: linear-gradient(var(--ash), transparent); animation: drip 2.2s var(--ease-inout) infinite; transform-origin: top; }
  @keyframes drip { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  .haze-a { animation: breathe 9s ease-in-out infinite alternate; }
  .haze-b { animation: breathe 13s ease-in-out infinite alternate-reverse; }
  @keyframes breathe { from { transform: scale(1) translateY(0); } to { transform: scale(1.12) translateY(-3%); } }

  /* ---------- smartphone ---------- */
  @media (max-width: 760px) {
    .hero { grid-template-rows: 0.8fr auto auto 1fr auto; padding-top: calc(76px + env(safe-area-inset-top)); }
    .sign { width: min(78vw, 36svh); }
    .title { grid-template-columns: minmax(0, 1fr); font-size: min(26vw, 15.5svh); justify-items: center; row-gap: 0.04em; margin-top: clamp(14px, 3vh, 28px); }
    .w-l, .w-r { grid-column: 1; justify-self: center; }
    .copy { grid-template-columns: 1fr; gap: 16px; }
    .sub { font-size: 16px; }
    .scroll { display: none; }
  }
  /* telefoni bassi (es. 360×640): compattare senza togliere la dicitura d'ingresso */
  @media (max-width: 760px) and (max-height: 700px) {
    .sign { width: min(64vw, 30svh); }
    .title { font-size: min(23vw, 14svh); }
    .sub { font-size: 15px; }
    .entry { font-size: 12px; }
  }
  @media (orientation: landscape) and (max-height: 520px) {
    .hero { min-height: 0; grid-template-rows: auto auto 1fr auto; padding-top: 60px; padding-bottom: 14px; }
    .sign { width: min(22vw, 38svh); grid-row: 1; }
    .title { grid-row: 2; font-size: min(9.5vw, 17svh); margin-top: 10px; grid-template-columns: minmax(0, 1fr) var(--beam-w) minmax(0, 1fr); }
    .w-l { grid-column: 1; justify-self: end; }
    .w-r { grid-column: 3; justify-self: start; }
    .copy { grid-row: 4; }
    .scroll { display: none; }
  }
</style>
