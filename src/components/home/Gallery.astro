---
import Picture from '../Picture.astro';

// sfere: foto già ritagliate in tondo dal sito del Classic (piccole, quindi restano medie)
const orbs = [
  { name: 'photo-pool-round', alt: 'La piscina illuminata di notte, con le persone intorno', label: 'Piscina e giardino', cls: 'o1', size: '300px' },
  { name: 'photo-floor-round', alt: 'Una sala del Classic piena, sotto le luci rosse', label: 'La sala', cls: 'o2', size: '251px' },
  { name: 'photo-performer-round', alt: 'Performer sospeso tra le luci blu del palco', label: 'Sul palco', cls: 'o3', size: '313px' },
];
const shots = [
  { name: 'photo-crowd', alt: 'La pista del Classic piena, luci calde e mani alzate verso la consolle', title: 'La pista', line: 'Due piste, un solo ritmo.', cls: 's1', sizes: '(min-width: 1024px) 48vw, 160vw' },
  { name: 'photo-aerial', alt: 'Performer al cerchio aereo sospesa nel fumo viola', title: 'Performance', line: 'Artisti, voci e performer dal vivo.', cls: 's2', sizes: '(min-width: 1024px) 40vw, 140vw' },
];
---
<section class="gallery" aria-labelledby="gallery-title" data-gallery>
  <div class="scene" data-scene>
    <h2 id="gallery-title" class="g-title display" data-eq>La notte<br />al Classic</h2>

    <div class="orbs" data-orbs>
      {orbs.map((o) => (
        <figure class={`orb ${o.cls}`} data-orb>
          <div class="orb-body" data-orb-body>
            <span class="halo" aria-hidden="true"></span>
            <div class="orb-img"><Picture name={o.name} alt={o.alt} sizes={o.size} /></div>
          </div>
          <figcaption data-orb-cap>{o.label}</figcaption>
        </figure>
      ))}
    </div>

    {shots.map((s) => (
      <figure class={`shot ${s.cls}`} data-shot>
        <div class="mask" data-shot-mask>
          <div class="inner" data-shot-inner><Picture name={s.name} alt={s.alt} sizes={s.sizes} /></div>
        </div>
        <figcaption>
          <b class="display" data-shot-title>{s.title}</b>
          <span data-shot-line>{s.line}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery { position: relative; }
  .scene { position: relative; padding: var(--section) var(--gutter); }

  .g-title { font-size: clamp(64px, 9vw, 150px); position: relative; z-index: 3; }
  .g-title :global(.ch) { will-change: transform; }

  /* ---------- sfere ---------- */
  .orbs { position: relative; height: 118vw; max-height: 700px; margin-block: 40px 8px; }
  .orb { position: absolute; margin: 0; will-change: transform; }
  .orb-body { position: relative; }
  .halo {
    position: absolute; inset: -22%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 45 111 / 0.38), rgb(180 76 255 / 0.16) 55%, transparent 72%);
    mix-blend-mode: screen;
  }
  .orb-body::after {
    content: ''; position: absolute; inset: -9px; border-radius: 50%; pointer-events: none;
    border: 1px solid rgb(242 240 235 / 0.22);
  }
  .orb-img { position: relative; border-radius: 50%; overflow: hidden; aspect-ratio: 1; }
  .orb-img :global(picture), .orb-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* duotono che scorre lentamente: le foto di anni diversi parlano la stessa lingua */
  .orb-img::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: linear-gradient(160deg, var(--accent), #3b0f5c 50%, #b44cff) 0 0 / 200% 200%;
    mix-blend-mode: color; opacity: 0.85; animation: duo 12s ease-in-out infinite alternate;
  }
  @keyframes duo { to { background-position: 100% 100%; } }
  .orb figcaption {
    position: absolute; left: 50%; bottom: -14px; translate: -50% 100%; white-space: nowrap;
    font-size: 13px; color: var(--bone); padding: 6px 12px; border-radius: var(--radius-pill);
    background: rgb(10 10 10 / 0.6); border: 1px solid var(--line); backdrop-filter: blur(6px);
  }
  .o1 { width: 54vw; left: 1vw; top: 0; }
  .o2 { width: 38vw; right: 2vw; top: 30vw; }
  .o3 { width: 34vw; left: 16vw; top: 72vw; }

  /* ---------- foto rettangolari ---------- */
  .shot { margin: 0; position: relative; z-index: 2; }
  .shot + .shot { margin-top: 56px; }
  .orbs + .shot { margin-top: 72px; }
  .mask { overflow: hidden; border-radius: 3px; aspect-ratio: 4 / 3; }
  .inner { height: 100%; will-change: transform; }
  .inner :global(picture), .inner :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shot figcaption { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-top: 14px; }
  .shot b { font-size: clamp(34px, 3.6vw, 60px); font-stretch: 62%; line-height: 0.9; }
  .shot span { color: var(--ash); }

  /* ---------- desktop: una sola scena composta, che GSAP fissa e coreografa ---------- */
  @media (min-width: 1024px) {
    .scene { height: 100svh; min-height: 680px; padding: 0; }
    .g-title { position: absolute; left: var(--gutter); top: 12svh; font-size: min(9vw, 15svh); }
    .orbs { position: absolute; inset: 0; height: auto; max-height: none; margin: 0; z-index: 4; pointer-events: none; }
    .orb { pointer-events: auto; }
    .o1 { width: min(15vw, 30svh); left: auto; right: 6vw; top: 60svh; }
    .o2 { width: min(11vw, 22svh); left: 51vw; right: auto; top: 67svh; }
    .o3 { width: min(9vw, 17svh); left: 37.5vw; top: 6svh; }
    .o3 figcaption { left: 100%; bottom: 50%; translate: 14px 50%; }
    .shot { position: absolute; }
    .shot + .shot, .orbs + .shot { margin-top: 0; }
    .s1 { right: 5vw; top: 12svh; width: min(47vw, 76svh); }
    .s1 .mask { aspect-ratio: 2 / 1; }
    .s2 { left: 7vw; top: 52svh; width: min(38vw, 62svh); }
    .s2 .mask { aspect-ratio: 16 / 9; }
    .shot figcaption { margin-top: 12px; }
  }
</style>
