---
import Picture from '../Picture.astro';

// monitor in loop: tre fotogrammi del Classic che si alternano a tagli secchi, a tempo
const loops = [
  { name: 'loop-pool', alt: 'La piscina illuminata di notte, con le persone intorno', label: 'Piscina e giardino' },
  { name: 'loop-sala', alt: 'Una sala del Classic piena, sotto le luci rosse', label: 'La sala' },
  { name: 'loop-palco', alt: 'Performer sospeso tra le luci blu del palco', label: 'Sul palco' },
];
// La pista si compone a barre (equalizzatore); Performance si apre come un occhio di bue
const panels = [
  { name: 'photo-crowd', alt: 'La pista del Classic piena, luci calde e mani alzate verso la consolle', title: 'La pista', cls: 'p1', fx: 'bars', sizes: '(min-width: 1024px) 48vw, 150vw' },
  { name: 'photo-aerial', alt: 'Performer al cerchio aereo sospesa nel fumo viola', title: 'Performance', cls: 'p2', fx: 'spot', sizes: '(min-width: 1024px) 40vw, 130vw' },
];
---
<section class="gallery" aria-labelledby="gallery-title" data-gallery>
  <div class="scene" data-scene>
    <h2 id="gallery-title" class="g-title display" data-neon>La notte<br />al Classic</h2>

    <figure class="monitor" data-monitor>
      <div class="crt" data-crt>
        {loops.map((l, i) => (
          <div class:list={['frame', { on: i === 0 }]} data-frame data-label={l.label}>
            <Picture name={l.name} alt={l.alt} sizes="240px" />
          </div>
        ))}
        <span class="scan" aria-hidden="true"></span>
        <span class="flash" aria-hidden="true" data-flash></span>
      </div>
      <figcaption>
        <span class="lbl" aria-hidden="true" data-frame-label>{loops[0].label}</span>
        <span class="sr-only">Loop di tre immagini: {loops.map((l) => l.label).join(', ')}.</span>
      </figcaption>
    </figure>

    {panels.map((p) => (
      <figure class={`panel ${p.cls}`} data-panel data-fx={p.fx}>
        <div class="screen" data-screen>
          <Picture name={p.name} alt={p.alt} sizes={p.sizes} class="src" />
          {p.fx === 'bars' && <div class="bars" aria-hidden="true" data-bars></div>}
          {p.fx === 'bars' && <span class="cue" aria-hidden="true" data-cue></span>}
          {p.fx === 'spot' && (
            <div class="spot" aria-hidden="true" data-spot><Picture name={p.name} alt="" sizes={p.sizes} /></div>
          )}
          <span class="flash" aria-hidden="true" data-flash></span>
        </div>
        <figcaption><b class="display" data-panel-title>{p.title}</b></figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .gallery { position: relative; }
  .scene { position: relative; padding: var(--section) var(--gutter); display: grid; gap: 32px; }

  /* ---------- titolo come insegna: lettere spente, una luce passa, alcune sono crepate ---------- */
  .g-title { font-size: clamp(64px, 9vw, 150px); position: relative; z-index: 3; color: var(--bone); }
  /* --lit = lettera accesa (colore), --glow = la luce che ci passa sopra (solo di passaggio) */
  .g-title :global(.nch) {
    --lit: 0; --glow: 0;
    position: relative;
    color: color-mix(in srgb, var(--bone) calc(var(--lit) * 100%), #6e6c67);
    text-shadow:
      0 0 calc(var(--glow) * 0.14em) rgb(242 240 235 / calc(var(--glow) * 0.5)),
      0 0 calc(var(--glow) * 0.4em) rgb(255 45 111 / calc(var(--glow) * 0.14));
  }
  .g-title :global(.crk .g) { color: transparent; text-shadow: none; }
  .g-title :global(.crk .h) { position: absolute; left: 0; top: 0; color: inherit; text-shadow: inherit; will-change: transform; }
  .g-title :global(.crk .a) { clip-path: polygon(0 0, 100% 0, 100% 43%, 0 59%); }
  .g-title :global(.crk .b) { clip-path: polygon(0 59%, 100% 43%, 100% 100%, 0 100%); }

  /* ---------- monitor in loop ---------- */
  .monitor { margin: 0; width: min(70vw, 320px); position: relative; z-index: 3; }
  .crt {
    position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 10px; background: #000;
    box-shadow: 0 0 0 1px rgb(242 240 235 / 0.16), 0 0 60px rgb(255 45 111 / 0.14);
    transform-origin: 50% 50%;
  }
  .frame { position: absolute; inset: 0; opacity: 0; }
  .frame.on { opacity: 1; }
  .frame :global(picture), .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame :global(img) { filter: grayscale(1) contrast(1.35) brightness(0.95); }
  .crt::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(160deg, var(--accent), #3b0f5c 60%, #b44cff); mix-blend-mode: color; opacity: 0.7;
  }
  .scan {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(0 0 0 / 0.38) 0 1px, transparent 1px 3px),
                radial-gradient(120% 120% at 50% 50%, transparent 55%, rgb(0 0 0 / 0.65));
    animation: roll 6s linear infinite;
  }
  @keyframes roll { to { background-position: 0 60px, 0 0; } }
  .flash { position: absolute; inset: 0; z-index: 3; background: var(--bone); opacity: 0; pointer-events: none; mix-blend-mode: screen; }
  .monitor figcaption { margin-top: 12px; }
  .lbl { font-family: var(--display); font-stretch: 75%; font-weight: 700; text-transform: uppercase; font-size: 18px; letter-spacing: 0.02em; }

  /* ---------- pannelli ---------- */
  .panel { margin: 0; position: relative; z-index: 2; }
  .screen { position: relative; overflow: hidden; border-radius: 3px; aspect-ratio: 3 / 2; touch-action: manipulation; }
  .screen :global(.src), .screen :global(.src img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .panel figcaption { margin-top: 14px; }
  .panel b { font-size: clamp(34px, 3.6vw, 60px); font-stretch: 62%; line-height: 0.9; }

  /* La pista: barre */
  .screen:global(.bars-on) :global(.src) { opacity: 0; }
  .bars { position: absolute; inset: 0; display: flex; }
  .bars :global(.bar) { position: relative; flex: 1 1 0; height: 100%; overflow: hidden; will-change: transform; }
  .bars :global(.slice) { position: absolute; inset: 0; will-change: transform; }
  .bars :global(.slice img) { position: absolute; top: 0; height: 100%; max-width: none; object-fit: cover; }
  .bars :global(.bar)::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 1px; background: rgb(0 0 0 / 0.55); }
  .cue {
    position: absolute; top: 0; bottom: 0; left: 0; width: 2px; margin-left: -1px; z-index: 2; pointer-events: none; opacity: 0;
    background: var(--bone); box-shadow: 0 0 12px 2px rgb(242 240 235 / 0.6), 0 0 40px 6px rgb(255 45 111 / 0.35);
  }

  /* Performance: palco al buio sotto, il cono di luce (copia a colori) sopra */
  .p2 .screen :global(.src img) { filter: grayscale(0.85) brightness(0.3) contrast(1.15); }
  .spot {
    position: absolute; inset: 0; --mx: 50%; --my: 45%; --r: 200vmax;
    mask: radial-gradient(circle at var(--mx) var(--my), #000 calc(var(--r) * 0.45), transparent var(--r));
  }
  .spot :global(picture), .spot :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- smartphone e tablet ---------- */
  @media (max-width: 1023px) {
    .monitor { justify-self: end; }
  }

  /* ---------- desktop: una sola scena composta, che GSAP fissa e coreografa ---------- */
  @media (min-width: 1024px) {
    .scene { display: block; height: 100svh; min-height: 680px; padding: 0; }
    .g-title { position: absolute; left: var(--gutter); top: 12svh; font-size: min(9vw, 15svh); }
    .monitor { position: absolute; right: 7vw; top: 61svh; width: min(16vw, 26svh); }
    .panel { position: absolute; }
    .p1 { right: 5vw; top: 12svh; width: min(48vw, 78svh); }
    .p1 .screen { aspect-ratio: 2 / 1; }
    .p2 { left: 7vw; top: 50svh; width: min(36vw, 58svh); }
    .p2 .screen { aspect-ratio: 16 / 9; }
    .panel figcaption { margin-top: 12px; }
  }
</style>
