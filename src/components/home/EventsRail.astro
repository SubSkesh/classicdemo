---
import EventCard from '../EventCard.astro';
import type { ClassicEvent } from '../../lib/events';
interface Props { events: ClassicEvent[] }
const { events } = Astro.props;
---
<section class="rail" aria-labelledby="rail-title" data-rail>
  <div class="rail-head wrap">
    <h2 id="rail-title" class="display" data-reveal-title>Prossime serate</h2>
    <a class="all" href="/serate/">Tutte le serate</a>
  </div>
  <div class="viewport" data-rail-viewport>
    <ul class="track" role="list" data-rail-track>
      {events.map((ev, i) => (
        <li><EventCard event={ev} eager={i === 0} /></li>
      ))}
      <li class="end">
        <a href="/serate/" data-cursor="Vai">
          <span class="display">Tutto<br />il programma</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .rail { padding-block: var(--section) calc(var(--section) * 0.6); }
  .rail-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: clamp(32px, 5vw, 64px); }
  h2 { font-size: var(--fs-h2); }
  .all { white-space: nowrap; padding-block: 8px; }

  /* mobile e reduced motion: swipe nativo con snap */
  .viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .viewport::-webkit-scrollbar { display: none; }
  .track { display: flex; gap: clamp(20px, 3vw, 48px); padding-inline: var(--gutter); width: max-content; }
  .track > li { width: min(80vw, 420px); scroll-snap-align: start; scroll-margin-inline: var(--gutter); }
  .end { display: grid; }
  .end a {
    display: grid; place-items: center; text-align: center; min-height: 100%; aspect-ratio: 4 / 5;
    border: 1px solid var(--line); border-radius: 3px; text-decoration: none; transition: border-color 0.4s, color 0.4s;
  }
  .end a:hover { border-color: var(--accent); color: var(--accent); }
  .end span { font-size: clamp(44px, 5vw, 80px); }

  /* desktop con movimento: il pin orizzontale lo gestisce GSAP */
  :global(html.rail-pinned) .rail { min-height: 100svh; padding-top: clamp(88px, 12vh, 128px); padding-bottom: 5vh; }
  :global(html.rail-pinned) .rail-head { margin-bottom: 4vh; }
  :global(html.rail-pinned) .viewport { overflow: visible; }
  :global(html.rail-pinned) .track { align-items: end; gap: clamp(48px, 5vw, 96px); }
  :global(html.rail-pinned) .track > li { width: auto; }
  /* nel binario la card diventa orizzontale: locandina alta quanto lo schermo permette, testo accanto */
  :global(html.rail-pinned) .track :global(.card) { grid-template-columns: auto 17rem; align-items: end; column-gap: 28px; }
  :global(html.rail-pinned) .track :global(.card h3) { font-size: clamp(34px, 3vw, 52px); }
  :global(html.rail-pinned) .track :global(.poster),
  :global(html.rail-pinned) .track :global(.poster picture),
  :global(html.rail-pinned) .track :global(.poster img) { height: min(56svh, 540px); width: auto; }
  :global(html.rail-pinned) .end a { height: min(56svh, 540px); width: auto; }
</style>
