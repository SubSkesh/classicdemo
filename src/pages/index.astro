---
import Base from '../layouts/Base.astro';
import Intro from '../components/home/Intro.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import EventsRail from '../components/home/EventsRail.astro';
import Manifesto from '../components/home/Manifesto.astro';
import Gallery from '../components/home/Gallery.astro';
import Membership from '../components/home/Membership.astro';
import { getEvents } from '../lib/events';

const events = await getEvents();
---
<Base page="home">
  <Intro />
  <Hero next={events[0]} />
  <Marquee />
  <EventsRail events={events} />
  <Manifesto />
  <Gallery />
  <Membership />
</Base>
