---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import Monogram from '../../components/Monogram.astro';
import { getEvents, dateParts, eventUrl, type ClassicEvent } from '../../lib/events';

export const getStaticPaths = (async () => {
  const events = await getEvents();
  return events.map((e, i) => ({
    params: { slug: e.id },
    props: { event: e, next: events[(i + 1) % events.length] },
  }));
}) satisfies GetStaticPaths;

const { event, next } = Astro.props as { event: ClassicEvent; next: ClassicEvent };
const e = event.data;
const d = dateParts(e.date);
const nd = dateParts(next.data.date);
const vt = `poster-${event.id}`;
---
<Base page="evento" title={e.title} description={`${e.title}, ${d.long} al Classic Club di Rimini. ${e.summary}`}>
  <article class="ev">
    <header class="top wrap">
      <a class="back" href="/serate/">Tutte le serate</a>
      <p class="label" data-fade>{e.label}</p>
      <h1 class="display" style={`view-transition-name: title-${event.id}`} data-split>{e.title}</h1>
      {e.subtitle && <p class="sub" data-fade>{e.subtitle}</p>}
    </header>

    <div class="body wrap">
      <figure class="poster" style={`view-transition-name: ${vt}`}>
        <Picture name={e.poster} alt={`Locandina ${e.title}, ${d.long} ${d.year}`} sizes="(min-width: 900px) 42vw, 100vw" loading="eager" fetchpriority="high" />
      </figure>

      <div class="side">
        <dl class="when" data-fade>
          <div><dt class="muted">Quando</dt><dd><b class="display">{d.day}.{d.month}</b><span>{d.long} {d.year}</span></dd></div>
          <div><dt class="muted">Orario</dt><dd><span>Dalle {e.start} alle {e.end}</span></dd></div>
          <div><dt class="muted">Dove</dt><dd><span>Classic Club, Via Feleto 15, Rimini</span></dd></div>
        </dl>

        <p class="summary" data-fade>{e.summary}</p>

        <div class="cta" data-fade>
          <button class="btn" type="button" data-dialog-open="dlg-lista" data-preselect={event.id}>Iscriviti in lista</button>
          <p class="muted">Ingresso ridotto per chi è in lista.</p>
        </div>

        <section class="lineup" aria-labelledby="lineup-title">
          <h2 id="lineup-title" class="h-small">Line-up</h2>
          {e.lineup.length ? (
            <dl>
              {e.lineup.map((g) => (
                <div class="group" data-fade>
                  <dt class="muted">{g.role}</dt>
                  {g.names.map((n) => <dd class="display">{n}</dd>)}
                </div>
              ))}
            </dl>
          ) : (
            <p class="tba display" data-fade>Line-up<br />in arrivo</p>
          )}
        </section>

        <section class="rules" aria-labelledby="rules-title">
          <h2 id="rules-title" class="h-small">Regole d'ingresso</h2>
          <ol role="list">
            <li><b>Documento d'identità valido.</b> Solo l'originale, niente foto sul telefono. <span lang="en" class="muted">Valid ID only, no photos.</span></li>
            <li><b>Tessera Classic, ARCI o ARCO.</b> Se è scaduta la rinnovi all'ingresso. <span lang="en" class="muted">Members only.</span></li>
            <li><b>Prima volta al Classic?</b> Fai il pre-tesseramento almeno 24 ore prima. <span lang="en" class="muted">New members: apply 24h in advance.</span></li>
            <li><b>18+.</b> <span lang="en" class="muted">18+ only.</span></li>
          </ol>
          <p class="safe">Il Classic è uno spazio di rispetto per ogni persona. Se qualcosa non va, cerca lo staff: ci siamo per questo.</p>
        </section>
      </div>
    </div>

    <a class="next wrap" href={eventUrl(next)} data-cursor="Vai">
      <span class="muted">Prossima serata in programma</span>
      <span class="next-title display"><Monogram class="next-mark" /> {nd.day}.{nd.month} {next.data.title}</span>
    </a>
  </article>
</Base>

<style>
  .top { padding-top: clamp(110px, 18vh, 180px); padding-bottom: clamp(28px, 4vw, 56px); }
  .back { display: inline-block; font-size: 14px; color: var(--ash); text-decoration: none; margin-bottom: 28px; padding-block: 6px; }
  .back::before { content: ''; display: inline-block; width: 24px; height: 1px; background: currentColor; vertical-align: middle; margin-right: 10px; transition: width 0.4s var(--ease-out); }
  .back:hover { color: var(--bone); }
  .back:hover::before { width: 40px; }
  .label { color: var(--accent); font-weight: 600; margin-bottom: 10px; }
  h1 { font-size: clamp(72px, 13vw, 240px); margin-left: -0.04em; overflow-wrap: anywhere; }
  .sub { font-size: var(--fs-lead); margin-top: 14px; }

  .body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 6vw, 110px); align-items: start; padding-bottom: var(--section); }
  .poster { position: sticky; top: 96px; margin: 0; border-radius: 3px; overflow: hidden; }
  .poster :global(img) { width: 100%; }
  .side { display: grid; gap: clamp(40px, 5vw, 64px); }

  .when { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .when > div { display: grid; grid-template-columns: 8rem 1fr; gap: 16px; padding-block: 16px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .when dd { display: grid; gap: 4px; }
  .when b { font-size: clamp(56px, 6vw, 96px); color: var(--accent); }
  .summary { font-size: var(--fs-lead); line-height: 1.35; max-width: 34ch; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .cta p { font-size: var(--fs-small); }

  .h-small { font-size: 15px; font-weight: 600; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .lineup dl { display: grid; gap: 28px; }
  .group dt { font-size: var(--fs-small); margin-bottom: 6px; }
  .group dd { font-size: clamp(36px, 4.4vw, 72px); line-height: 0.92; }
  .tba { font-size: clamp(44px, 5vw, 80px); color: var(--ash); }

  .rules ol { display: grid; gap: 14px; counter-reset: r; }
  .rules li { counter-increment: r; display: grid; grid-template-columns: 2rem 1fr; }
  .rules li::before { content: counter(r); color: var(--accent); font-weight: 600; }
  .rules li > * { grid-column: 2; }
  .rules li b { font-weight: 600; }
  .rules li { column-gap: 0; }
  .rules li :is(b, span) { display: inline; }
  .safe { margin-top: 24px; padding: 18px 20px; border-left: 2px solid var(--accent); background: var(--night-2); max-width: 52ch; }

  .next { display: grid; gap: 10px; padding-block: clamp(48px, 8vw, 110px); border-top: 1px solid var(--line); text-decoration: none; }
  .next-title { font-size: clamp(44px, 8vw, 140px); display: flex; align-items: center; gap: 0.25em; flex-wrap: wrap; transition: color 0.4s; }
  .next-title :global(.next-mark) { height: 0.55em; width: auto; color: var(--accent); }
  .next:hover .next-title { color: var(--accent); }

  @media (max-width: 860px) {
    .body { grid-template-columns: 1fr; }
    .poster { position: relative; top: 0; }
    .when > div { grid-template-columns: 6rem 1fr; }
  }
</style>
